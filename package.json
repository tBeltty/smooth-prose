{
  "name": "smooth-prose",
  "version": "1.0.0",
  "description": "Context-agnostic editorial suite for human cadence, zero AI slop, and deterministic text linting.",
  "type": "module",
  "main": "bin/smooth-lint.mjs",
  "bin": {
    "smooth-prose": "bin/smooth-prose",
    "smooth-lint": "bin/smooth-lint.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "heuristics",
    "rules",
    "skills",
    "integrations",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "node bin/smooth-lint.mjs",
    "test": "node --test tests/cli.test.mjs",
    "evals:list": "node tests/evals/evals.mjs list",
    "evals:score": "node tests/evals/evals.mjs score"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agents",
    "ai-slop",
    "anti-slop",
    "burstiness",
    "claude",
    "copywriting",
    "cursor",
    "editorial",
    "en",
    "es",
    "fiction",
    "linter",
    "nlp",
    "prose-linter",
    "style-guide",
    "writing"
  ],
  "homepage": "https://github.com/tBeltty/smooth-prose#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tBeltty/smooth-prose.git"
  },
  "bugs": {
    "url": "https://github.com/tBeltty/smooth-prose/issues"
  },
  "author": "Smooth Prose Contributors",
  "license": "MIT"
}
