      "^(?:\\w+\\s+){0,3}(?:days?|weeks?|months?|years?|hours?|minutes?)\\s+(?:later|earlier|before|after)\\b",
      "^(?:A|One)\\s+(?:day|week|month|year|hour)\\s+later\\b",
