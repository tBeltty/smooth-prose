        "label": "it's not X, it's Y"
      },
      {
        "regex": "\\b(?:isn['’]?t|is\\s+not|wasn['’]?t|was\\s+not|aren['’]?t|are\\s+not|weren['’]?t)\\s+(?:just\\s+|only\\s+)?(?:an?\\s+|the\\s+)?[^.,;:—\\n]{2,60},\\s*but\\s+",
        "label": "isn't X, but Y"
      },
      {
        "regex": "\\bnot\\s+(?:just|only|merely|simply)\\s+[^.,;:—\\n]+,?\\s*but\\s+(?:also\\s+)?",
        "label": "not just X, but Y"
      },
      {
        "regex": "\\bnot\\s+because\\s+[^.,;:—\\n]+,?\\s*but\\s+because\\b",
        "label": "not because X, but because Y"
      }
